      "disabled": true,
      "settings": {
        "title": "Holly Lollies Asian Mystery Box: Travel through Asia!",
        "text": "Ready to spice up your snack game? The Holly Lollies Asian Mystery Box is your passport to a world of exotic and delicious treats! Packed with the most tantalizing candies and snacks from Japan, Korea, China, and beyond, each box is a unique adventure in taste .Perfect for curious foodies and adventurous snackers, this box is a flavor explosion waiting to happen. It's also a fabulous gift for friends and family who love exploring new tastes. Get ready for a sweet and sassy surprise in every box! 🌏🍬✨",
        "btn_title": "",
        "btn_url": "",
        "image": "shopify:\/\/shop_images\/Untitled_design_4.png"
      }
    },
