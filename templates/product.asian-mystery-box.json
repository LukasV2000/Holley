      "type": "Index_reviews_carousel",
      "blocks": {
        "6e8599fa-7c68-4bac-ad28-57cf7eaa9011": {
          "type": "Slide",
          "settings": {
            "video": "https:\/\/cdn.shopify.com\/videos\/c\/o\/v\/07da1bd8f60f498a98df83404f3c81fd.mp4",
            "headline": "“I've had other snack boxes but, Holly Lollies is definitely my favorite. Great variety of tasty snacks, both sweet and savory. My box even included some ramen! I would definitely recommend this for anyone that wants to try exotic snacks.”",
            "name": "— Indrė",
            "info": "Proud Client from Lithuania 🇱🇹"
          }
        },
        "2c215d2b-bde2-4695-8a45-86edb60d5c32": {
          "type": "Slide",
          "settings": {
            "video": "https:\/\/cdn.shopify.com\/videos\/c\/o\/v\/722b3abc83ff4a408e14dfa3c621fb57.mp4",
            "headline": "“It's all delicious and let's you try different flavor combinations you never would have thought of or had the chance to experience.\"",
            "name": "— Karolina",
            "info": "Proud Client from Lithuania 🇱🇹"
          }
        },
        "818d02f9-85ba-4332-a43a-47e56fff2718": {
          "type": "Slide",
          "settings": {
            "video": "https:\/\/cdn.shopify.com\/videos\/c\/o\/v\/2f62e6daf68e4ddba80b1921cf3c0d0b.mp4",
            "headline": "“I’d been introduced to them through a friend, though I’d heard about them before. I’ve been impressed with the range of snacks and drinks, and the effort put into each box. Even with the occasional repeat snack, it’s still always delicious. It’s worth the price, and worth the time to enjoy a big bite of exotic candies.”",
            "name": "— Džestina",
            "info": "Happy Client from Lithuania 🇱🇹"
          }
        },
        "0b69fa11-51bd-4e48-968a-ec117b9d9f92": {
          "type": "Slide",
          "settings": {
            "video": "https:\/\/cdn.shopify.com\/videos\/c\/o\/v\/34389683f8c34c9ba6f6c1094b667491.mp4",
            "headline": "“Tasting the Japanese KitKat Matcha was like a quick trip back to Japan. The variety in this box is incredible – each candy is a new discovery. For anyone thinking about trying Holly Lollies, I say go for it. It's a world tour for your taste buds and every bite is top quality. Holly Lollies, you've got yourself a fan – this is easily a 10\/10 from me!\"”",
            "name": "— Kamėja",
            "info": "Proud Client from Lithuania 🇱🇹"
          }
        }
      },
