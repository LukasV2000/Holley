    "index_multi_features_mod_V8JJW8": {
      "type": "Index_multi_features_mod",
      "blocks": {
        "feature_BjKRNF": {
          "type": "feature",
          "settings": {
            "heading": "PARTY TIME 🎉",
            "text": "Turn any gathering into an unforgettable event with our mystery boxes, filled with unique, trendy snacks. Perfect for Instagram-worthy moments, these treats elevate your celebration. Our boxes guarantee great emotions and lively debates as you discover which candies you love and which ones your friends can’t stand.",
            "image": "shopify:\/\/shop_images\/download_1.gif",
            "icon": ""
          }
        },
        "feature_jK4J4M": {
          "type": "feature",
          "settings": {
            "heading": "Family Feasting 👪",
            "text": "Looking to bond with your kids? Or maybe you want to be the cool uncle or aunt? This box has got you covered! Our mystery boxes are perfect for creating fun moments together. Share the excitement and become the hero of family gatherings. Perfect for any family get-together, our mystery boxes ensure everyone finds their favorites, bringing joy, laughter, and unforgettable memories to every family moment.",
            "image": "shopify:\/\/shop_images\/Ekrano_kopija_2024-06-07_161320.png",
            "icon": ""
          }
        },
        "feature_4BcmXY": {
          "type": "feature",
          "settings": {
            "heading": "Flavorful Gifting 🎁",
            "text": "Looking for a standout gift? Our mystery boxes are packed with unique and luxurious treats, perfect for any occasion. Delight your loved ones with high-end, trendy candies that impress. Ideal for birthdays, anniversaries, or just because—these boxes bring joy and excitement to any celebration. Share the fun and sweeten the moment with a thoughtful and unforgettable gift!",
            "image": "shopify:\/\/shop_images\/Ekrano_kopija_2024-06-07_161338.png",
            "icon": ""
          }
        },
        "feature_DGK7pr": {
          "type": "feature",
          "settings": {
            "heading": "Solo Adventure 🍫",
            "text": "Treat yourself to unique and exciting snacks that let you explore new flavors. Enjoy some well-deserved me-time with a diverse selection of treats designed to make your solo moments special and satisfying. Dive into personal indulgence and savor each surprise just for you. Unwind and relax with snacks that bring stress-free enjoyment. Give yourself the gift of exclusivity with treats chosen to delight you on your solo adventures.",
            "image": "shopify:\/\/shop_images\/5_c129b7ee-fb58-4530-b1a7-020880b69fa9.jpg",
            "icon": ""
          }
        }
      },
