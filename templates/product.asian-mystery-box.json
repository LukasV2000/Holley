    "939fe1cf-87b0-4404-b1ef-5be59fbcf5d4": {
      "type": "Customer_says_reviews",
      "blocks": {
        "3e43814c-aff7-46e4-8bcd-8eefc907db47": {
          "type": "Review",
          "settings": {
            "avatar": "shopify:\/\/shop_images\/2_07967477-4bff-47c9-a6be-71d016e041be.png",
            "name": "Jonas R.",
            "info": "Happy customer from 🇱🇹",
            "content": "<p>I’ve had tried Trendy and Asian mystery boxes so far and both have been amazing! The selection of candies truly amazed me. I have already recommended hollylollies to others, and plan to re-up mine again soon!<\/p>"
          }
        },
        "f50736a8-0ae1-41fc-9ed9-b29e478584a5": {
          "type": "Review",
          "settings": {
            "avatar": "shopify:\/\/shop_images\/3_2db29d62-7616-43e1-bd1d-a4d7beb3a9a5.png",
            "name": "Jolanda Gaile",
            "info": "Proud customer from 🇱🇻",
            "content": "<p>Nostalgia. Plain and simple. I had been stationed in Japan for four years and had a great time trying new food and snacks when I was there. Wanting to share that with my kids now, we got this and now I’m sharing memories with them and explaining where I had certain ones before. Love it!<\/p>"
          }
        },
        "6a35730d-2035-45bd-bccd-c488666cbc06": {
          "type": "Review",
          "settings": {
            "avatar": "shopify:\/\/shop_images\/5_7219f865-d6db-4f99-96b8-5bb5d377994b.png",
            "name": "Mateusz Wróbel",
            "info": "Happy customer from 🇵🇱",
            "content": "<p>My partner was so happy! I got this as an important gift because I know she likes Japanese themed things and longs to visit Japan and it did not disappoint. Everything arrived perfectly and it was received faster than I thought it would. Highly recommend!<\/p>"
          }
        },
        "1d026fc1-9182-4a4d-a23e-f00c81313ee5": {
          "type": "Review",
          "settings": {
            "avatar": "shopify:\/\/shop_images\/2_b99b379b-0535-4eec-b291-47fca148424c.png",
            "name": "Livita Runce",
            "info": "Proud customer from 🇱🇻",
            "content": "<p>For the price it's an exceptional value and I like that it has a balanced selection of sweet and savory snacks and that they are full sized. I also noticed that all the snacks in this box were fresh. No stale crackers or chips like I've experienced in other similar boxes. Very pleased with this purchase and would highly recommend to friends, family, and as a gift.<\/p>"
          }
        },
        "6ec83660-8eae-4718-a2d9-460ca0f35c91": {
          "type": "Review",
          "settings": {
            "avatar": "shopify:\/\/shop_images\/6_1fa22cf3-bf3a-4875-b674-11c24450180e.png",
            "name": "Anne Kivi",
            "info": "Proud customer from 🇪🇪",
            "content": "<p>I was very pleasantly surprised with how much was in the box, and how tasty everything has been! So far I have tried a half dozen or so items. These are all things I would buy again if I saw them!<\/p>"
          }
        },
        "85f99483-9520-4b2d-ba93-f2f09355f6d7": {
          "type": "Review",
          "settings": {
            "avatar": "shopify:\/\/shop_images\/4_eabeeca5-ab45-41ea-8c38-9366a6ab9322.png",
            "name": "Gytis Abelkis",
            "info": "Happy Customer from 🇱🇹",
            "content": "<p>Loved every single piece from the box, cant wait to get the next one. All snacks were in perfect conditions and delicious.<\/p>"
          }
        },
        "60d8d18e-74e9-4c51-b13f-345b620b4aa8": {
          "type": "Review",
          "settings": {
            "avatar": "shopify:\/\/shop_images\/Ellipse_7.png",
            "name": "Leonīds Viļums",
            "info": "Proud customer from 🇱🇻",
            "content": "<p>Amazing lots of food to try definitely worth the price compared to other boxes.<\/p>"
          }
        },
        "284d89ef-da6e-436b-81aa-5dc026b5cf3d": {
          "type": "Review",
          "settings": {
            "avatar": "shopify:\/\/shop_images\/5_9e31cf33-3b62-4dc5-8f18-a31525cabf4e.png",
            "name": "Veronika Vaitytė",
            "info": "Happy Customer from 🇱🇹",
            "content": "<p>I recently ordered Holly Lollies' Mystery Box, not quite sure what to expect. To my delight, it turned out to be an amazing experience for the whole family! 🤩<br\/><br\/>The best part was sharing the excitement with my family. We all gathered around to taste international sweets from places we've never been. The variety was incredible, and it made for a fun and memorable tasting adventure. 🤩<br\/><br\/>If you're up for a taste adventure, I highly recommend giving Holly Lollies a try. You won't be disappointed!<\/p>"
          }
        },
        "253488bc-81ef-488a-ab1a-0d3bdc35f9c7": {
          "type": "Review",
          "settings": {
            "avatar": "shopify:\/\/shop_images\/4_fd994df5-84e5-40bd-bace-b82be928e32e.png",
            "name": "Julian Wieczorek",
            "info": "Proud customer from 🇵🇱",
            "content": "<p>All of the snacks were really good I definitely recommend Holly Lollies and I will most certainly get another box.<\/p>"
          }
        },
        "d3f034f8-f8bb-41e1-8310-a94812245c4a": {
          "type": "Review",
          "settings": {
            "avatar": "shopify:\/\/shop_images\/3_2d6e6a51-f9d2-428b-8dd9-a6a9c1058b29.png",
            "name": "Ugnius L.",
            "info": "Happy customer from 🇱🇹",
            "content": "<p>Amazing service much better than a large competitor who can’t actually deliver. Holly Lollies box arrived with in 3 business days . The treats were tasty and well explained. Highly recommend.<\/p>"
          }
        },
        "dfab66f7-6717-4e7f-b625-b15e905cf1bb": {
          "type": "Review",
          "settings": {
            "avatar": "shopify:\/\/shop_images\/1_302b8794-6d78-48d6-86e3-72d7d945d30a.png",
            "name": "Jonas",
            "info": "Happy customer from Asia",
            "content": "<p>Great experience!! Wide variety of snacks ranging from sweet to savory. Well thought out and everything was super tasty!<\/p>"
          }
        },
        "c822337a-0105-48de-8cdb-1e217ac5aca7": {
          "type": "Review",
          "disabled": true,
          "settings": {
            "avatar": "shopify:\/\/shop_images\/1.png",
